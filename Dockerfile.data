FROM python:3.12-slim

RUN pip install --no-cache-dir qdrant-client openai python-dotenv requests mwparserfromhell

WORKDIR /app
COPY data/*.py data/avatar_chunks.jsonl.gz data/SNAPSHOT /app/

# Load the baked snapshot into Qdrant. Run sync_wiki.py afterwards (or on a
# schedule) to converge on the live wiki.
CMD ["python", "embed_data.py"]
